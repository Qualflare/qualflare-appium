{
  "name": "@qualflare/appium",
  "version": "0.2.0",
  "description": "Qualflare reporter for Appium suites run through WebdriverIO — iOS and Android results with device capabilities, per-attempt retries, flakiness and the screenshots Appium takes, labelled as Appium.",
  "keywords": [
    "qualflare",
    "appium",
    "webdriverio",
    "wdio",
    "wdio-reporter",
    "xcuitest",
    "uiautomator2",
    "mobile-testing",
    "test-reporter",
    "test-reporting",
    "flaky-tests"
  ],
  "homepage": "https://github.com/Qualflare/qualflare-appium#readme",
  "bugs": {
    "url": "https://github.com/Qualflare/qualflare-appium/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qualflare/qualflare-appium.git"
  },
  "license": "Apache-2.0",
  "author": "Qualflare",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js",
      "require": "./dist/service.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@qualflare/webdriverio": "^0.2.0"
  },
  "peerDependencies": {
    "webdriverio": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.50",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.0.0",
    "eslint": "^10.9.1",
    "execa": "^9.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^3.2.0",
    "webdriverio": "^9.32.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:built": "npm run build && vitest run test/built",
    "test:integration": "vitest run test/integration --pool=forks --testTimeout=300000 --hookTimeout=300000",
    "test:all": "npm run test && npm run test:built && npm run test:integration",
    "prepublishOnly": "npm run build",
    "test:e2e": "node -e \"require('node:fs').rmSync('e2e-results',{recursive:true,force:true})\" && node e2e/link-self.mjs && cd e2e && wdio run wdio.conf.mjs",
    "verify:e2e": "node e2e/verify-report.mjs",
    "e2e": "npm run test:e2e && npm run verify:e2e"
  }
}
